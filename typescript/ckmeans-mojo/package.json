{
  "name": "ckmeans-mojo-workspace",
  "version": "0.1.4",
  "private": true,
  "description": "ckmeans-mojo: drop-in faster ckmeans for simple-statistics, powered by a Mojo kernel.",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:fallback": "CKMEANS_MOJO_DISABLE_NATIVE=1 node --test tests/*.test.cjs",
    "test:all": "bash scripts/test_all.sh",
    "bench": "node ../../benchmarks/bench_ckmeans.mjs"
  },
  "devDependencies": {
    "simple-statistics": "7.12.0"
  }
}
